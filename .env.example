# --- Kern ---
DATABASE_URL=./data/pinion.db
# 32 Byte, base64 – erzeugen mit: npm run gen:key
TOKEN_ENC_KEY=
# Muss für Threads (und meist X) HTTPS sein → im Dev z.B. via `cloudflared tunnel --url http://localhost:8787`
PUBLIC_BASE_URL=http://localhost:8787
AUTH_PORT=8787
DEFAULT_TIMEZONE=Europe/Zurich

# Nur 127.0.0.1 lassen; vom Laptop per `ssh -L 8787:127.0.0.1:8787 pi` zugreifen
AUTH_HOST=127.0.0.1

# replies = nur Antworten brauchen Freigabe | all = auch eigene Posts überall
APPROVAL_MODE=replies
# Plattformen, auf denen auch eigene Posts freigegeben werden müssen
APPROVAL_POSTS_PLATFORMS=reddit,devto
WORKER_TICK_SECONDS=30

# Backups (Default: neben der DB). Z.B. NAS-Freigabe – danach sudo ./deploy/install.sh erneut ausführen
# BACKUP_DIR=/mnt/nas/backups/pinion
# BACKUP_KEEP=14
INBOX_POLL_MINUTES=15
# X verrechnet jeden Read – Inbox-Polling für X deshalb standardmässig aus
INBOX_POLL_X=false

# --- X (developer.x.com, OAuth 2.0, Typ "Web App / confidential") ---
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- LinkedIn (Produkte "Sign In with LinkedIn" + "Share on LinkedIn") ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Aktuelle Version in der LinkedIn-Doku prüfen (Format YYYYMM)
LINKEDIN_VERSION=202610

# --- Threads (Meta App mit Threads-Use-Case) ---
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- Reddit (erst nach Freigabe gemäss Responsible Builder Policy) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:pinion:v0.1.0 (by /u/DEIN_USERNAME)

# --- Bluesky (kein OAuth: Handle + App-Passwort im Connect-Formular) ---
BLUESKY_SERVICE=https://bsky.social

# --- Dev.to (kein OAuth: API-Key im Connect-Formular) ---
