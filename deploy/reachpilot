#!/usr/bin/env bash
# ReachPilot-Befehl auf dem Pi. Läuft immer als Service-User "reachpilot",
# damit Datenbank und .env nur diesem User gehören.
#
#   reachpilot status            Überblick: Accounts, Queue, Fehler
#   reachpilot review [i|…]      Freigabe-Queue (wie npm run review)
#   reachpilot connect           Connect-Server starten (Accounts verbinden), Ctrl+C beendet
#   reachpilot mcp               MCP-Server über stdio (für Claude Desktop/Code via SSH)
#   reachpilot backup            Datenbank-Backup jetzt
#   reachpilot migrate           Datenbank-Schema aktualisieren
#   reachpilot logs              Worker-Log live
set -euo pipefail
APP_DIR="${REACHPILOT_DIR:-/opt/reachpilot}"

if [[ "$(id -un)" != "reachpilot" ]]; then
  case "${1:-}" in
    logs) exec journalctl -u reachpilot-worker -f -n 100 ;;
  esac
  exec sudo -n -u reachpilot "$0" "$@"
fi

cd "$APP_DIR"
cmd="${1:-status}"; shift || true
case "$cmd" in
  status)  exec node dist/cli/status.js "$@" ;;
  review)  exec node dist/cli/review.js "$@" ;;
  connect) exec node dist/auth/oauth-server.js "$@" ;;
  mcp)     exec node dist/mcp/server.js "$@" ;;
  backup)  exec node dist/cli/backup.js "$@" ;;
  migrate) exec node dist/db/migrate.js "$@" ;;
  worker)  exec node dist/worker/index.js "$@" ;;
  *) echo "Unbekannter Befehl: $cmd (status | review | connect | mcp | backup | migrate | logs)" >&2; exit 1 ;;
esac
